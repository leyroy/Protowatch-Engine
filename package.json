{
  "name": "protowatch-engine",
  "version": "1.0.0",
  "description": "Hybrid Android cellular threat detection engine for ProtoWatch",
  "main": "src/index.ts",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react-native",
    "cellular",
    "security",
    "imsi-catcher",
    "threat-detection"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react-native": "^0.73.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.21.0",
    "react-native": ">=0.73.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__mocks__/react-native.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/async-storage.ts"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
